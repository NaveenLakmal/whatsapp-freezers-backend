# =============================================================================
# WhatsApp Chat Backend — Environment Configuration Template
# Copy this file to .env and set your actual values.
# =============================================================================

# Server port (Koyeb sets PORT automatically; fallback is 3000)
PORT=3000

# Node environment (development | production)
NODE_ENV=development

# =============================================================================
# Authentication
# Static API key that the Flutter app must send in the `x-api-key` header.
# Set a strong random string in production.
# =============================================================================
API_KEY=change-me-to-a-strong-random-secret

# =============================================================================
# Database
# SQLite connection string for development / local container.
# For managed PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# =============================================================================
DATABASE_URL="file:./dev.db"

# =============================================================================
# WhatsApp / Baileys Authentication Storage
# Directory where multi-file auth credentials are saved.
# Supported variable names: BAILEYS_AUTH_DIR or AUTH_STATE_DIR.
# =============================================================================
BAILEYS_AUTH_DIR=./auth_info_baileys
AUTH_STATE_DIR=./auth_state

# =============================================================================
# Media Storage Directory
# Directory where downloaded attachments (images, audio, docs) are stored.
# =============================================================================
MEDIA_UPLOAD_DIR=./uploads

# =============================================================================
# View-Once Media
# When true (default), view-once image/video messages are downloaded and stored
# permanently on disk so they remain accessible in chat history.
# ⚠️  PRIVACY WARNING: This bypasses the sender's expectation that the media
# disappears after one view. Only enable this if you understand and accept the
# privacy implications for whoever sent the media.
# Set to false to disable and preserve the ephemeral behaviour.
# =============================================================================
SAVE_VIEW_ONCE_MEDIA=true
